# ================================================================
# 딜 관리 시스템 — nginx 설정 예시 (Linux 내부 서버)
#  - 정적 파일(01_src) 서빙 + Self-hosted Supabase(Kong :8000) 역방향 프록시
#  - 같은 주소로 묶으면 CORS 설정이 필요 없고, config.js 의 SUPABASE_URL 을
#    이 서버 주소(예: https://dealsys.사내도메인)로 지정하면 됩니다.
# ================================================================
server {
    listen 443 ssl;
    server_name dealsys.INTERNAL_DOMAIN;           # ★ 사내 도메인

    ssl_certificate     /etc/nginx/certs/dealsys.crt;   # ★ 사내 인증서
    ssl_certificate_key /etc/nginx/certs/dealsys.key;

    root  /var/www/dealsys;                         # ★ 01_src 내용 배치 경로
    index index.html;
    charset utf-8;

    # 접근 허용 대역 (★ VDI 대역으로 제한)
    # allow 10.0.0.0/8;
    # deny  all;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;

    # 설정·화면 파일은 캐시하지 않음 (배포 즉시 반영)
    location ~* \.(html|js)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /vendor/ {
        expires 30d;
    }

    # ── Supabase API 프록시 (supabase-js 가 호출하는 경로) ──
    location ~ ^/(rest|storage|auth)/v1/ {
        proxy_pass http://127.0.0.1:8000;           # ★ Kong 게이트웨이 주소
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50m;                    # 첨부파일 최대 크기와 맞출 것
    }
}
